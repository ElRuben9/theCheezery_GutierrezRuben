<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/welcomeFragment">

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="gutierrez.ruben.thecheezery_gutierrezruben.WelcomeFragment"
        android:label="Welcome">
        <action
            android:id="@+id/action_welcome_to_login"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="gutierrez.ruben.thecheezery_gutierrezruben.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_login_to_menu"
            app:destination="@id/menuFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/menuFragment"
        android:name="gutierrez.ruben.thecheezery_gutierrezruben.MenuFragment"
        android:label="The Cheezery">
        <action
            android:id="@+id/action_menu_to_products"
            app:destination="@id/productsFragment" />
        <action
            android:id="@+id/action_menu_to_cart"
            app:destination="@id/cartFragment" />
    </fragment>

    <fragment
        android:id="@+id/productsFragment"
        android:name="gutierrez.ruben.thecheezery_gutierrezruben.ProductsFragment"
        android:label="Products">
        <argument
            android:name="category"
            app:argType="string" />
        <action
            android:id="@+id/action_products_to_cart"
            app:destination="@id/cartFragment" />
    </fragment>

    <fragment
        android:id="@+id/cartFragment"
        android:name="gutierrez.ruben.thecheezery_gutierrezruben.CartFragment"
        android:label="My Order" />
</navigation>
