<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/Dusty_white"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp"
    tools:context=".LoginFragment"
    tools:theme="@style/Theme.TheCheezery_GutierrezRuben">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginBottom="35dp"
        android:contentDescription="The Cheezery logo"
        android:scaleType="fitCenter"
        android:src="@drawable/grupo1" />

    <EditText
        android:id="@+id/edit_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:autofillHints="emailAddress"
        android:backgroundTint="@color/Very_purple"
        android:hint="Correo electrónico"
        android:inputType="textEmailAddress"
        android:padding="14dp"
        android:singleLine="true"
        android:textSize="17sp" />

    <EditText
        android:id="@+id/edit_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:autofillHints="password"
        android:backgroundTint="@color/Very_purple"
        android:hint="Contraseña"
        android:inputType="textPassword"
        android:padding="14dp"
        android:singleLine="true"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/text_login_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#D32F2F"
        android:textSize="14sp" />

    <Button
        android:id="@+id/button_login"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/Brighter_Pink"
        android:text="Entrar"
        android:textAllCaps="false"
        android:textColor="@color/white" />
</LinearLayout>
