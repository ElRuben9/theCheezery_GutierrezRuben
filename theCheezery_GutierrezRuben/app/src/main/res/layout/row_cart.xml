<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="10dp"
    android:paddingEnd="6dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/text_cart_product_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#FF373137"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/text_cart_product_price"
        android:layout_width="76dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/Very_purple"
        android:textSize="20sp" />

    <Button
        android:id="@+id/button_remove"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:backgroundTint="@color/DisabledGrey"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="×"
        android:textColor="@color/Purple_grey"
        android:textSize="20sp" />
</LinearLayout>
