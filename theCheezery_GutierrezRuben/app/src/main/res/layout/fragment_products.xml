<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/Dusty_white"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".ProductsFragment"
    tools:theme="@style/Theme.TheCheezery_GutierrezRuben">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:backgroundTint="@color/Very_purple"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="‹"
            android:textColor="@color/white"
            android:textSize="28sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/button_cart"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:backgroundTint="@color/Very_purple"
            android:text="🛒 0"
            android:textAllCaps="false"
            android:textColor="@color/white" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_category_title"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center"
        android:textColor="@color/Pinky"
        android:textSize="44sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/product_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
